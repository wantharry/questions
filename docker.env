# Docker Environment Configuration for QuestionsApp
# Copy this file to .env and customize as needed

# ==========================================
# LLM Configuration
# ==========================================
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
# For Docker, use host.docker.internal to access host Ollama
# Or use http://ollama:11434 if using --profile with-ollama
LLM_BASE_URL=http://host.docker.internal:11434
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# OpenAI (if using)
# OPENAI_API_KEY=your-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# ==========================================
# Embeddings Configuration
# ==========================================
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
USE_GPU=false

# Alternative embedding models:
# EMBEDDING_MODEL=sentence-transformers/all-mpnet-base-v2  # Higher quality, 768-dim
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5                   # Efficient, 384-dim
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5                    # Balance, 768-dim
# EMBEDDING_MODEL=BAAI/bge-large-en-v1.5                   # Best quality, 1024-dim

# ==========================================
# Vector Store Configuration
# ==========================================
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_TYPE=IndexFlatL2
SIMILARITY_TOP_K=5

# ==========================================
# Document Processing
# ==========================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_WORKERS=4
ENABLE_OCR=true
OCR_LANGUAGE=eng

# ==========================================
# Ingestion Settings
# ==========================================
BATCH_SIZE=50
RESUME_ON_ERROR=true
SKIP_EXISTING=true

# ==========================================
# API Configuration
# ==========================================
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8601
API_WORKERS=1

# ==========================================
# Frontend Configuration
# ==========================================
BACKEND_URL=http://backend:8601
STREAMLIT_SERVER_PORT=8602
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# ==========================================
# Ollama Service (if using --profile with-ollama)
# ==========================================
OLLAMA_HOST=0.0.0.0
