# RAG Question Generator - Environment Configuration
# Copy this file to .env and customize as needed

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
APP_NAME=RAG Question Generator
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================================
# PATHS
# ============================================================================
DATA_DIR=./data
VECTOR_STORE_DIR=./data/vector_store
METADATA_DB_PATH=./data/metadata/metadata.db
LOGS_DIR=./data/logs
MODELS_DIR=./models

# ============================================================================
# LLM CONFIGURATION (Pluggable)
# ============================================================================

# Choose your LLM provider: ollama, openai, llama_cpp, vllm
LLM_PROVIDER=ollama

# Ollama Configuration (Default - Local & Free)
LLM_MODEL=mistral:7b-instruct
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=120

# Alternative Models for Ollama:
# LLM_MODEL=llama3:8b
# LLM_MODEL=phi3:mini

# OpenAI Configuration (Uncomment to use)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your_api_key_here
# LLM_MODEL=gpt-4

# vLLM Configuration
# LLM_PROVIDER=vllm
# OPENAI_BASE_URL=http://localhost:8000/v1

# ============================================================================
# EMBEDDINGS CONFIGURATION (Pluggable)
# ============================================================================

EMBEDDING_PROVIDER=sentence_transformers

# Fast & Efficient (Default)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Better Quality Options:
# EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
# EMBEDDING_DIMENSION=768

EMBEDDING_DEVICE=cpu  # or 'cuda' for GPU
EMBEDDING_BATCH_SIZE=32

# ============================================================================
# VECTOR STORE CONFIGURATION
# ============================================================================

VECTOR_STORE_TYPE=faiss
FAISS_INDEX_TYPE=IndexFlatL2
SIMILARITY_TOP_K=5

# ============================================================================
# DOCUMENT PROCESSING
# ============================================================================

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_WORKERS=4
BATCH_SIZE=50

ENABLE_OCR=true
OCR_LANGUAGE=eng

RESUME_ON_ERROR=true
SKIP_EXISTING=true

# ============================================================================
# API SETTINGS
# ============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ============================================================================
# FRONTEND SETTINGS
# ============================================================================
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
