# RAG Question Generator Configuration
# Copy this file to .env and customize as needed

# ============================================================
# Application Settings
# ============================================================
APP_NAME=RAG Question Generator
ENVIRONMENT=development
LOG_LEVEL=INFO

# ============================================================
# API & Server Ports
# ============================================================
API_HOST=0.0.0.0
API_PORT=8601
STREAMLIT_SERVER_PORT=8602

# ============================================================
# LLM Configuration (Pluggable)
# ============================================================
# Options: ollama, openai, llama_cpp, vllm
LLM_PROVIDER=ollama
LLM_MODEL=mistral:7b-instruct
LLM_BASE_URL=http://localhost:11434
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# For OpenAI (if LLM_PROVIDER=openai)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================
# Embeddings Configuration
# ============================================================
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Use GPU for embeddings (requires CUDA)
# EMBEDDING_DEVICE=cuda

# ============================================================
# Vector Store Settings
# ============================================================
VECTOR_STORE_TYPE=faiss
FAISS_INDEX_TYPE=IndexFlatL2
SIMILARITY_TOP_K=5

# ============================================================
# Document Processing
# ============================================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_WORKERS=4

# OCR for images/scanned PDFs (requires Tesseract)
ENABLE_OCR=false
OCR_LANGUAGE=eng

# ============================================================
# Ingestion Settings
# ============================================================
BATCH_SIZE=50
RESUME_ON_ERROR=true
SKIP_EXISTING=true

# ============================================================
# Paths (relative to backend/)
# ============================================================
DATA_DIR=./data
VECTOR_STORE_DIR=./data/vector_store
METADATA_DB_PATH=./data/metadata/metadata.db
LOGS_DIR=./data/logs
MODELS_DIR=./models

# ============================================================
# Advanced Hybrid RAG Settings (v2.0)
# ============================================================
# BM25 Parameters
BM25_K1=1.5
BM25_B=0.75

# Hybrid Search Weights (auto-adjusted by router)
DEFAULT_DENSE_WEIGHT=0.5
DEFAULT_SPARSE_WEIGHT=0.5
DEFAULT_RERANK=true

# Reranker Model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# GPU Settings
USE_GPU=false
